# ── Database ──────────────────────────────────────────────────────────────────
# asyncpg URL used by the FastAPI app at runtime
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/hexalog

# psycopg2 URL used by Alembic only (sync driver required)
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:password@localhost:5432/hexalog

# Separate test database — required for pytest
TEST_DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/hexalog_test

# ── Auth ──────────────────────────────────────────────────────────────────────
# Minimum 32 random characters. Rotate on suspected compromise.
JWT_SECRET_KEY=change-me-to-a-random-32-char-secret-key

# Separate key for HMAC-SHA256 hashing of refresh tokens before DB storage.
# Must be different from JWT_SECRET_KEY. Minimum 32 characters.
REFRESH_TOKEN_HASH_KEY=change-me-to-a-different-32-char-secret-key

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Session inactivity window — confirmed 480 min (8 h) by Arpit 2026-06-19
SESSION_INACTIVITY_MINUTES=480

# Hard cap on session lifetime regardless of activity
SESSION_ABSOLUTE_EXPIRE_HOURS=24

# Grace window for overlapping browser refresh calls before treating as theft
REFRESH_REUSE_GRACE_SECONDS=30

# ── Password ──────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── Brute-force protection ────────────────────────────────────────────────────
LOGIN_RATE_LIMIT_PER_MINUTE=5
LOGIN_MAX_FAILURES=10
LOGIN_LOCKOUT_MINUTES=15

# ── Session housekeeping ──────────────────────────────────────────────────────
SESSION_RETENTION_DAYS=30

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO

# Comma-separated list of allowed CORS origins (no trailing slash)
CORS_ORIGINS=http://localhost:5173
